<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Image_is_null</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISNULL(Image__c ),ISBLANK(Image__c))</errorConditionFormula>
    <errorMessage>Image field should not be blank</errorMessage>
</ValidationRule>
